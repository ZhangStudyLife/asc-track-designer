{
  "name": "asc-track-designer",
  "version": "2.0.2",
  "description": "ASC实验室智能车赛道设计器 - 专业的赛道布局设计工具",
  "private": true,
  "author": "ASC实验室",
  "keywords": [
    "智能车",
    "赛道设计",
    "ASC",
    "实验室工具"
  ],
  "main": "electron.js",
  "scripts": {
    "dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build && node scripts/prepare-standalone.js",
    "start": "electron .",
    "start:next": "next start",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rimraf .next out release node_modules"
  },
  "build": {
    "appId": "com.asc.trackdesigner",
    "productName": "ASC赛道设计器",
    "copyright": "Copyright © 2024 ASC实验室",
    "asar": true,
    "icon": "public/icon.ico",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ASC赛道设计器",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "files": [
      "public/**/*",
      "electron.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "extraMetadata": {
      "main": "electron.js"
    }
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "konva": "^9.3.14",
    "next": "15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  }
}
