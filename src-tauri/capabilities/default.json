{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by the ASC track designer window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/ZhangStudyLife/asc-track-designer" },
        { "url": "https://github.com/ZhangStudyLife" },
        { "url": "https://github.com/ZhangStudyLife/asc-track-designer/releases/tag/*" },
        { "url": "https://*.supabase.co/auth/v1/authorize*" }
      ]
    }
  ]
}
